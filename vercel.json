{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "https://temporal.io/temporal-cookie-policy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/v1/consent-banner.js",
      "destination": "/consent-banner.iife.js"
    },
    {
      "source": "/v1/consent-banner.esm.js",
      "destination": "/consent-banner.es.js"
    }
  ],
  "headers": [
    {
      "source": "/v1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
